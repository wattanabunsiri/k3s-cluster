# Terraform / Terragrunt state.
# Never commit these: live/k3s-cluster/terraform.tfstate embeds the k3s cluster
# join token, which is enough to add a node to the cluster.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.tfstate.lock.info
.terragrunt-cache/

# Local overrides and variable files that tend to hold credentials.
*.auto.tfvars
*.tfvars
!example.tfvars
.env
.env.*

# Superseded Terraform modules, kept locally for reference only.
# The observability stack they deploy now lives in argocd-apps/ and is managed
# by ArgoCD. Their live/ wrappers are gone, so these can no longer be applied —
# they are excluded so nobody mistakes them for the current source of truth.
modules/monitoring/
modules/logging/

# Kubeconfigs
kubeconfig
*.kubeconfig

# macOS
.DS_Store
